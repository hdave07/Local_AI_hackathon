{
  "version": 1,
  "notes": "T-002 benchmark set. Synthetic, non-sensitive. Matchers: action ('none' = no action), kind, args (case-insensitive exact), contains (case-insensitive substring), nonEmpty (arg keys). A case passes if the validated intent matches ANY entry in 'accept'.",
  "intent": [
    {"id": "I01", "utterance": "open notes", "accept": [{"action": "activate_app", "args": {"app": "Notes"}}]},
    {"id": "I02", "utterance": "open mail", "accept": [{"action": "activate_app", "args": {"app": "Mail"}}]},
    {"id": "I03", "utterance": "launch calendar", "accept": [{"action": "activate_app", "args": {"app": "Calendar"}}]},
    {"id": "I04", "utterance": "switch to safari", "accept": [{"action": "activate_app", "args": {"app": "Safari"}}]},
    {"id": "I05", "utterance": "let me review the draft", "accept": [{"action": "request_review"}]},
    {"id": "I06", "utterance": "put mail and calendar side by side", "accept": [{"action": "tile_windows", "args": {"left": "Mail", "right": "Calendar"}}]},
    {"id": "I07", "utterance": "put notes on the left and safari on the right", "accept": [{"action": "tile_windows", "args": {"left": "Notes", "right": "Safari"}}]},
    {"id": "I08", "utterance": "move this window to the left half", "accept": [{"action": "move_window", "args": {"window": "active", "position": "left_half"}}]},
    {"id": "I09", "utterance": "maximize the mail window", "accept": [{"action": "move_window", "args": {"window": "Mail", "position": "maximize"}}]},
    {"id": "I10", "utterance": "make this window a little wider", "accept": [{"action": "resize_window", "args": {"window": "active", "change": "wider"}}]},
    {"id": "I11", "utterance": "make the calendar window smaller", "accept": [{"action": "resize_window", "args": {"window": "Calendar", "change": "smaller"}}]},
    {"id": "I12", "utterance": "scroll down", "accept": [{"action": "scroll", "args": {"direction": "down"}}]},
    {"id": "I13", "utterance": "scroll to the top", "accept": [{"action": "scroll", "args": {"direction": "top"}}]},
    {"id": "I14", "utterance": "click the reply button", "accept": [{"action": "click_element", "contains": {"label": "reply"}}]},
    {"id": "I15", "utterance": "click new message", "accept": [{"action": "click_element", "contains": {"label": "new message"}}]},
    {"id": "I16", "utterance": "focus the search field", "accept": [{"action": "focus", "contains": {"label": "search"}}]},
    {"id": "I17", "utterance": "type hello everyone", "accept": [{"action": "insert_text", "contains": {"text": "hello everyone"}}]},
    {"id": "I18", "utterance": "change 3 to 3:30", "accept": [{"action": "replace_text", "args": {"old": "3", "new": "3:30"}}]},
    {"id": "I19", "utterance": "replace tuesday with wednesday", "accept": [{"action": "replace_text", "contains": {"old": "tuesday", "new": "wednesday"}}]},
    {"id": "I20", "tags": ["draft-content"], "utterance": "reply to sarah that I can meet tomorrow", "accept": [{"action": "create_draft", "contains": {"recipient": "sarah", "content": "meet tomorrow"}}]},
    {"id": "I21", "tags": ["draft-content"], "utterance": "email john saying the report is ready", "accept": [{"action": "create_draft", "contains": {"recipient": "john", "content": "report is ready"}}]},
    {"id": "I22", "tags": ["draft-content"], "utterance": "write to alex and ask if friday works", "accept": [{"action": "create_draft", "contains": {"recipient": "alex", "content": "friday"}}]},
    {"id": "I23", "tags": ["draft-content"], "utterance": "reply to sarah: thanks, see you at four", "accept": [{"action": "create_draft", "contains": {"recipient": "sarah", "content": "see you"}}]},
    {"id": "I24", "tags": ["email-search"], "utterance": "find sarah's email about tomorrow", "accept": [{"action": "read_message", "contains": {"query": "sarah"}}]},
    {"id": "I25", "tags": ["email-search"], "utterance": "open the latest email from john", "accept": [{"action": "read_message", "contains": {"query": "john"}}]},
    {"id": "I26", "tags": ["email-search"], "utterance": "search my mail for the budget report", "accept": [{"action": "read_message", "contains": {"query": "budget"}}]},
    {"id": "I27", "tags": ["email-search"], "utterance": "show me the email from alex about the offsite", "accept": [{"action": "read_message", "contains": {"query": "alex"}}]},
    {"id": "I28", "utterance": "do I have anything at four tomorrow", "accept": [{"action": "query_calendar", "nonEmpty": ["time"]}]},
    {"id": "I29", "utterance": "am I free on friday afternoon", "accept": [{"action": "query_calendar", "contains": {"time": "friday"}}]},
    {"id": "I30", "utterance": "send it", "accept": [{"action": "request_send"}]}
