    {"id": "A10", "utterance": "change the time", "accept": [{"kind": "clarification"}]},
    {"id": "A11", "utterance": "email sarah", "accept": [{"action": "create_draft", "contains": {"recipient": "sarah"}}, {"kind": "clarification"}]},
    {"id": "A12", "utterance": "close it", "accept": [{"kind": "clarification"}, {"kind": "unsupported"}]},
    {"id": "A13", "utterance": "find that email", "accept": [{"kind": "clarification"}, {"action": "read_message"}]},
