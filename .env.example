# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Argmax runtime key (starts with ax_, 34 chars). Not the axst_ registry token.
ARGMAX_API_KEY=
# Only if a model repository requires it.
HF_TOKEN=
FLOW_LMSTUDIO_URL=http://localhost:1234/v1
FLOW_MODEL_ID=ternary-bonsai-2-2b-mlx
# 1 = build without the Argmax registry dependency (no registry login needed).
FLOW_DISABLE_ARGMAX=0
# 1 = enable live test suites.
FLOW_LIVE_LLM=0
FLOW_LIVE_ARGMAX=0
