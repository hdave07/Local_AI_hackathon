<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Flow</string>
	<key>CFBundleDisplayName</key><string>Flow</string>
	<key>CFBundleIdentifier</key><string>dev.flow.FlowApp</string>
	<key>CFBundleExecutable</key><string>FlowApp</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>0.1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<!-- Shown by macOS in the microphone consent prompt (ADR 0002 §3). Audio is never stored. -->
	<key>NSMicrophoneUsageDescription</key><string>Flow listens for your spoken commands while you have listening turned on. Audio is processed on this Mac and never stored.</string>
	<!-- Shown by macOS in the Automation consent prompt before Flow can use Apple Mail (read-only search and open). -->
	<key>NSAppleEventsUsageDescription</key><string>Flow uses Apple Mail's scripting interface to find, open and read your messages when you ask. Flow does not send, delete or change messages.</string>
	<!-- LM Studio is plain HTTP on localhost; allow local networking only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key><true/>
	</dict>
</dict>
</plist>
